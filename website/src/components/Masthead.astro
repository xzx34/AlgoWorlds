---
import type { SiteCopy } from "../content/copy";
import { siteConfig } from "../data/site";
import Icon, { type IconName } from "./Icon.astro";

interface Props {
  copy: SiteCopy;
}

const { copy } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const actions: Array<{ label: string; icon: IconName; href: string }> = [
  { ...siteConfig.resources.paper, icon: "paper" },
  { ...siteConfig.resources.repository, icon: "github" },
];
---

<header class="masthead page-shell" data-reveal="hero">
  <h1>{copy.masthead.title}</h1>
  <p class="team-name">
    <img src={`${base}${siteConfig.brandMark}`} alt="" width="28" height="28" aria-hidden="true" />
    <span>{siteConfig.organizationName}</span>
  </p>
  <nav class="project-actions" aria-label={copy.masthead.actionsLabel}>
    {actions.map((action) => (
      <a class="project-link" href={action.href} target="_blank" rel="noopener noreferrer">
        <Icon name={action.icon} />
        <span>{action.label}</span>
      </a>
    ))}
  </nav>
</header>
