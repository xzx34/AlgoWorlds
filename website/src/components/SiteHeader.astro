---
import type { SiteCopy } from "../content/copy";
import { siteConfig } from "../data/site";

interface Props {
  copy: SiteCopy;
}

const { copy } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<header class="site-header">
  <nav class="page-shell site-nav" aria-label={copy.nav.label}>
    <a class="site-brand" href={base} aria-label={copy.nav.home}>
      <img src={`${base}${siteConfig.brandMark}`} alt="" width="25" height="25" aria-hidden="true" />
      <span>Weixin AI</span>
    </a>
    <div class="site-links">
      <a href="#abstract">{copy.nav.abstract}</a>
      <a href="#results">{copy.nav.results}</a>
      <a href="#benchmark">{copy.nav.benchmark}</a>
    </div>
  </nav>
</header>
